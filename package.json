{
  "name": "cuestage",
  "productName": "CueStage",
  "version": "0.1.0",
  "description": "Show control for conferences: QLab-style cue list with Stagetimer-style timers",
  "author": "CueStage",
  "license": "GPL-3.0-or-later",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fetch-mpv": "node scripts/fetch-mpv.mjs",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^10.24.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.cuestage",
    "productName": "CueStage",
    "files": ["main/**", "renderer/**", "web/**", "docs/**", "package.json"],
    "extraResources": [{ "from": "vendor/mpv", "to": "mpv", "filter": ["**/*"] }],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "CueStage-Setup-${version}.exe" },
    "portable": { "artifactName": "CueStage-Portable-${version}.exe" },
    "fileAssociations": [{ "ext": "cuestage", "name": "CueStage Show", "role": "Editor" }]
  }
}
